DATABASE_URL=sqlite:///./data/app.db
JWT_SECRET=change-me-in-production
CORS_ORIGINS=["http://localhost:5173"]

# Optional — login-alert emails (services/email.py, ported from v1).
# If SMTP_HOST is unset, alerts are just logged, never sent (safe no-op).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_USE_TLS=1

# Optional — Google / Apple sign-in (app/api/routes/oauth.py). Sign-in stays
# email/password-only until these are set; hitting the endpoints without
# them returns 501.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/google/callback
# APPLE_CLIENT_ID=
# APPLE_REDIRECT_URI=http://localhost:5173/oauth/apple/callback

# Passkeys (app/api/routes/passkey.py) — works out of the box for local dev
# with the defaults below. In production these MUST match your real domain
# (WebAuthn ties every credential to the exact origin it was registered on;
# passkeys registered against the wrong rp_id/origin will fail to verify).
# PASSKEY_RP_ID=localhost
# PASSKEY_RP_NAME=Fishing Forecast
# PASSKEY_RP_ORIGIN=http://localhost:5173
