# Copy this file to .env and fill in your values.
# Load it before starting the app: export $(grep -v '^#' .env | xargs)
# Or use python-dotenv: pip install python-dotenv

# Required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Set to 1 when running behind a reverse proxy (nginx, Caddy, etc.)
# Required for IP-based rate limiting to use the real client IP from X-Forwarded-For.
# TRUSTED_PROXY=1

# Set to 1 to mark session cookies as Secure (HTTPS-only). Required in production.
# SESSION_COOKIE_SECURE=1

# Comma-separated list of usernames to grant admin privileges on startup.
# ADMIN_USERS=yourusername

# Port the dev server listens on (default: 5757)
# PORT=5757

# Default fallback coordinates used when no user location is set.
# Defaults to Wrightsville Beach, NC — override for a different regional default.
# DEFAULT_LAT=34.2104
# DEFAULT_LNG=-77.7964

# Set to 1 to enable Flask debug mode (never use in production)
# FLASK_DEBUG=0

# SMTP settings for email verification (required to send verification emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@gmail.com
# SMTP_USE_TLS=1      # "1" for STARTTLS (default), "ssl" for SMTP_SSL, "0" for plain

# Opt-in fishing-condition notifications.
# The background poller is on by default but never sends anything until a user
# opts in (Account → Fishing Condition Alerts) AND a channel is configured.
# NOTIFICATIONS_ENABLED=1            # set 0 to disable the poller entirely
# NOTIFICATION_POLL_INTERVAL=900     # seconds between checks (0 disables)
# SITE_URL=https://yourdomain.com    # absolute base URL for alert links
#
# Web Push (VAPID) — required for browser push alerts. Needs the optional
# pywebpush dependency (in requirements.txt). Generate a key pair with:
#   python -m py_vapid --gen
# VAPID_PUBLIC_KEY=your-url-safe-base64-public-key
# VAPID_PRIVATE_KEY=your-url-safe-base64-private-key
# VAPID_SUBJECT=mailto:you@example.com

# Google OAuth (Sign in with Google)
# Create credentials at https://console.cloud.google.com/ → APIs & Services → Credentials
# Add your callback URL as an Authorized redirect URI: https://yourdomain.com/auth/google/callback
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In
# Set up at https://developer.apple.com/ → Certificates, Identifiers & Profiles → Services IDs
# APPLE_CLIENT_ID=com.example.yourapp.service     # Your Service ID
# APPLE_TEAM_ID=ABCDE12345                         # 10-character Team ID
# APPLE_KEY_ID=ABC123DEFG                          # Key ID from Sign in with Apple key
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# (replace real newlines with \n if storing on a single line)
