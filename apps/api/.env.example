# Local FastAPI configuration. These values are not production secrets.
APP_ENV=development
DATABASE_URL=postgresql://surf_pier:local-development-only@127.0.0.1:5432/surf_pier
LOG_LEVEL=INFO

# Must match the local BFF values. Production secrets are configured through
# the hosting providers and are never copied from this file.
INTERNAL_API_ACTIVE_KEY_ID=local-v1
INTERNAL_API_ACTIVE_SECRET=local-internal-secret-replace-before-deploy
