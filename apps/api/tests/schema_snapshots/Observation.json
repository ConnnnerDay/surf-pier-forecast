{
  "description": "A single attributed value, per docs/product-definition.md's\nattribution rules: every decision-relevant value keeps its provider,\nstation, observed/issued/valid time, unit, freshness, and fallback\nstatus.",
  "properties": {
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "is_fallback": {
      "default": false,
      "title": "Is Fallback",
      "type": "boolean"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "station_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Station Id"
    },
    "unit": {
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "title": "Value",
      "type": "number"
    }
  },
  "required": [
    "value",
    "unit",
    "provider",
    "observed_at"
  ],
  "title": "Observation",
  "type": "object"
}
