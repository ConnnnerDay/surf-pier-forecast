[Unit]
Description=Surf & Pier Fishing Forecast
Documentation=https://github.com/ConnnnerDay/surf-pier-forecast
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=REPLACE_DIR
ExecStart=REPLACE_DIR/.venv/bin/python app.py
Restart=on-failure
RestartSec=10
Environment=PORT=5757

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=REPLACE_DIR/data REPLACE_DIR/static/uploads

[Install]
WantedBy=multi-user.target
