[Unit]
Description=Surf & Pier Fishing Forecast
Documentation=https://github.com/ConnnnerDay/surf-pier-forecast
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=REPLACE_DIR
# Use gunicorn (production WSGI server) instead of the Flask dev server.
# 2 sync workers handle concurrent requests without the GIL bottleneck;
# increase to 4 on multi-core machines.  Bind to localhost only and put
# nginx or another reverse proxy in front for TLS termination.
ExecStart=REPLACE_DIR/.venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5757 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    "app:create_app()"
Restart=on-failure
RestartSec=10
Environment=PORT=5757
# Set SESSION_COOKIE_SECURE=true only when running behind HTTPS (TLS termination
# at nginx/reverse proxy).  Omit or set to empty string for plain HTTP.
# Environment=SESSION_COOKIE_SECURE=true

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=REPLACE_DIR/data

[Install]
WantedBy=multi-user.target
